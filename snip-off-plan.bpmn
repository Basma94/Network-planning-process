    <bpmn:startEvent id="START" name="New requirement arrives outside the approved DB"/>
    <bpmn:task id="OFF_001" name="OFF-001 Identify Requirement">
      <bpmn:documentation>Phase 1. Identify a new commercial, internal or technical requirement. Team: Business / Commercial / Network Requestor. Tool: Email, customer request, business documentation. Output: Requirement. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_002" name="OFF-002 Define Business Need">
      <bpmn:documentation>Phase 1. Describe the business problem, expected outcome and urgency. Team: Requestor. Tool: Demand documentation. Output: Business requirement. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_003" name="OFF-003 Identify Request Type">
      <bpmn:documentation>Phase 1. Determine whether the request is commercial, internal, strategic or operational. Team: Requestor. Tool: Pega Demand Front Door. Output: Demand classification. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_004" name="OFF-004 Identify Impacted Markets">
      <bpmn:documentation>Phase 1. Specify affected countries and network organisations. Team: Requestor. Tool: Pega. Output: Market information. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_005" name="OFF-005 Identify Sponsor">
      <bpmn:documentation>Phase 1. Record business sponsor and accountable contact. Team: Requestor. Tool: Pega. Output: Sponsor details. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_006" name="OFF-006 Define Required Date">
      <bpmn:documentation>Phase 1. Record requested delivery date and business deadlines. Team: Requestor. Tool: Pega. Output: Required delivery date. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_007" name="OFF-007 Estimate Initial Effort">
      <bpmn:documentation>Phase 1. Provide preliminary effort or resource expectations. Team: Requestor. Tool: Pega. Output: Initial estimate. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_008" name="OFF-008 Identify Funding Position">
      <bpmn:documentation>Phase 1. Indicate whether funding or WBS codes already exist. Team: Requestor. Tool: Pega. Output: Funding information. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_009" name="OFF-009 Identify Dependencies">
      <bpmn:documentation>Phase 1. Record contractual, technical and system dependencies. Team: Requestor. Tool: Pega. Output: Dependency information. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_010" name="OFF-010 Attach Supporting Evidence">
      <bpmn:documentation>Phase 1. Attach business case, scope, quotations or supporting material. Team: Requestor. Tool: Pega. Output: Supporting documents. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_011" name="OFF-011 Submit Demand">
      <bpmn:documentation>Phase 1. Formally submit request. Team: Requestor. Tool: Pega. Output: Demand record. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_012" name="OFF-012 Generate Demand Reference">
      <bpmn:documentation>Phase 1. Register the request for subsequent tracking. Team: Demand Management. Tool: Pega. Output: Demand identifier. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_8" name="D1 · Demand complete?"/>
    <bpmn:task id="OFF_013" name="OFF-013 Review Submitted Demand">
      <bpmn:documentation>Phase 2. Examine request completeness and supporting information. Team: Demand Management. Tool: Pega. Output: Review result. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_014" name="OFF-014 Validate Request Classification">
      <bpmn:documentation>Phase 2. Confirm internal/external demand route. Team: Demand Management. Tool: Pega. Output: Confirmed classification. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_015" name="OFF-015 Check Existing Demand">
      <bpmn:documentation>Phase 2. Identify related or previously submitted requests. Team: Demand Management. Tool: Pega / existing records. Output: Duplicate assessment. Status: T</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_016" name="OFF-016 Check Existing Programme">
      <bpmn:documentation>Phase 2. Determine whether the requirement belongs to an existing programme. Team: Planning / Demand Management. Tool: BPT / planning records. Output: Programme alignment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_017" name="OFF-017 Check Approved DB">
      <bpmn:documentation>Phase 2. Determine whether investment is already included in the financial plan. Team: Network Market Planning. Tool: BPT. Output: In-plan/off-plan assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_018" name="OFF-018 Identify Responsible Network Function">
      <bpmn:documentation>Phase 2. Determine impacted network verticals. Team: Demand Management. Tool: Pega. Output: Functional assignment. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_019" name="OFF-019 Assign Technical Assessment">
      <bpmn:documentation>Phase 2. Route demand to relevant technical stakeholders. Team: Demand Management. Tool: Pega. Output: Assessment ownership. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_020" name="OFF-020 Assess Initial Priority">
      <bpmn:documentation>Phase 2. Evaluate urgency and business significance. Team: Business Sponsor / Planning. Tool: Assessment criteria. Output: Priority. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_021" name="OFF-021 Confirm Qualification">
      <bpmn:documentation>Phase 2. Accept demand for detailed assessment or return/reject. Team: Demand Management. Tool: Pega. Output: Qualification decision. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_9" name="Qualified?"/>
    <bpmn:exclusiveGateway id="GW_10" name="D2 · Covered by approved investment?"/>
    <bpmn:task id="OFF_022" name="OFF-022 Review Technical Requirement">
      <bpmn:documentation>Phase 3. Examine functional and non-functional requirements. Team: Network Engineering. Tool: Pega / documents. Output: Requirement assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_023" name="OFF-023 Identify Network Domains">
      <bpmn:documentation>Phase 3. Identify transmission, IP, RAN, Core or other impacted domains. Team: Network Engineering. Tool: Network documentation. Output: Domain assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_024" name="OFF-024 Analyse Existing Capacity">
      <bpmn:documentation>Phase 3. Assess available infrastructure and capacity. Team: Network Planning / Engineering. Tool: Network analytics. Output: Capacity assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_025" name="OFF-025 Identify Technical Options">
      <bpmn:documentation>Phase 3. Develop feasible solution alternatives. Team: Solution Architecture. Tool: Design tools. Output: Solution options. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_026" name="OFF-026 Assess Dependencies">
      <bpmn:documentation>Phase 3. Identify systems, infrastructure and delivery dependencies. Team: Engineering. Tool: Design documentation. Output: Dependency register. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_027" name="OFF-027 Assess Security Impact">
      <bpmn:documentation>Phase 3. Determine whether security assessment is required. Team: Security / Engineering. Tool: Security process. Output: Security requirements. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_028" name="OFF-028 Assess Supplier Dependencies">
      <bpmn:documentation>Phase 3. Identify vendor equipment or services. Team: Engineering / Supply Chain. Tool: Supplier information. Output: Supplier requirements. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_029" name="OFF-029 Estimate Delivery Effort">
      <bpmn:documentation>Phase 3. Estimate engineering activities and implementation complexity. Team: Engineering / Delivery. Tool: Estimation templates. Output: Effort estimate. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_030" name="OFF-030 Estimate Technical Costs">
      <bpmn:documentation>Phase 3. Calculate equipment and implementation costs. Team: Engineering / Finance. Tool: Excel / costing tools. Output: Cost estimate. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_031" name="OFF-031 Identify Delivery Risks">
      <bpmn:documentation>Phase 3. Evaluate technical and implementation risks. Team: Engineering / Delivery. Tool: Risk register. Output: Risk assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_032" name="OFF-032 Confirm Preferred Solution">
      <bpmn:documentation>Phase 3. Select technically appropriate option. Team: Engineering / Solution Architecture. Tool: Design approval process. Output: Preferred solution. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_033" name="OFF-033 Complete Technical Assessment">
      <bpmn:documentation>Phase 3. Confirm feasibility and outstanding conditions. Team: Engineering. Tool: Pega / documents. Output: Technical assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_11" name="D3 · Technically feasible?"/>
    <bpmn:task id="OFF_034" name="OFF-034 Identify Resource Roles">
      <bpmn:documentation>Phase 4. Define required engineering and delivery roles. Team: Engineering / Delivery. Tool: Pega / estimates. Output: Role requirements. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_035" name="OFF-035 Estimate Resource Effort">
      <bpmn:documentation>Phase 4. Estimate person-days or FTE requirements. Team: Engineering / Delivery. Tool: Estimation tools. Output: Resource estimate. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_036" name="OFF-036 Create Resource Demand">
      <bpmn:documentation>Phase 4. Register workforce requirements. Team: Resource Management. Tool: WFM / local process. Output: Resource request. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_037" name="OFF-037 Check Workforce Capacity">
      <bpmn:documentation>Phase 4. Identify available resources. Team: Resource Management. Tool: WFM. Output: Capacity position. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_038" name="OFF-038 Identify Skills Gaps">
      <bpmn:documentation>Phase 4. Compare required skills with available workforce. Team: Resource Management. Tool: WFM. Output: Skills gap. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_039" name="OFF-039 Assess Competing Commitments">
      <bpmn:documentation>Phase 4. Identify conflicts with existing projects. Team: Resource Management. Tool: WFM. Output: Resource conflicts. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_040" name="OFF-040 Determine Booking Requirement">
