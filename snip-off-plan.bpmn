    <bpmn:startEvent id="START" name="New requirement arrives outside the approved DB"/>
    <bpmn:task id="OFF_001" name="OFF-001 Identify Requirement">
      <bpmn:documentation>Phase 1. Identify a new commercial, internal or technical requirement. Team: Business / Commercial / Network Requestor. Tool: Email, customer request, business documentation. Output: Requirement. Status: V. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_002" name="OFF-002 Define Business Need">
      <bpmn:documentation>Phase 1. Describe the business problem, expected outcome and urgency. Team: Requestor. Tool: Demand documentation. Output: Business requirement. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_003" name="OFF-003 Identify Request Type">
      <bpmn:documentation>Phase 1. Determine whether the request is commercial, internal, strategic or operational. Team: Requestor. Tool: Pega Demand Front Door. Output: Demand classification. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_004" name="OFF-004 Identify Impacted Markets">
      <bpmn:documentation>Phase 1. Specify affected countries and network organisations. Team: Requestor. Tool: Pega. Output: Market information. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_005" name="OFF-005 Identify Sponsor">
      <bpmn:documentation>Phase 1. Record business sponsor and accountable contact. Team: Requestor. Tool: Pega. Output: Sponsor details. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_006" name="OFF-006 Define Required Date">
      <bpmn:documentation>Phase 1. Record requested delivery date and business deadlines. Team: Requestor. Tool: Pega. Output: Required delivery date. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_007" name="OFF-007 Estimate Initial Effort">
      <bpmn:documentation>Phase 1. Provide preliminary effort or resource expectations. Team: Requestor. Tool: Pega. Output: Initial estimate. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_008" name="OFF-008 Identify Funding Position">
      <bpmn:documentation>Phase 1. Indicate whether funding or WBS codes already exist. Team: Requestor. Tool: Pega. Output: Funding information. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_009" name="OFF-009 Identify Dependencies">
      <bpmn:documentation>Phase 1. Record contractual, technical and system dependencies. Team: Requestor. Tool: Pega. Output: Dependency information. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_010" name="OFF-010 Attach Supporting Evidence">
      <bpmn:documentation>Phase 1. Attach business case, scope, quotations or supporting material. Team: Requestor. Tool: Pega. Output: Supporting documents. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_011" name="OFF-011 Submit Demand">
      <bpmn:documentation>Phase 1. Formally submit request. Team: Requestor. Tool: Pega. Output: Demand record. Status: C. Confidence: provisional (SNIP consolidated analysis model; verify against the governing Vodafone procedure.)</bpmn:documentation>
    </bpmn:task>
