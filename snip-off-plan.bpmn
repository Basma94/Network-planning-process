      <bpmn:documentation>Phase 1. Identify a new commercial, internal or technical requirement. Team: Business / Commercial / Network Requestor. Tool: Email, customer request, business documentation. Output: Requirement. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_002" name="OFF-002 Define Business Need">
      <bpmn:documentation>Phase 1. Describe the business problem, expected outcome and urgency. Team: Requestor. Tool: Demand documentation. Output: Business requirement. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_003" name="OFF-003 Identify Request Type">
      <bpmn:documentation>Phase 1. Determine whether the request is commercial, internal, strategic or operational. Team: Requestor. Tool: Pega Demand Front Door. Output: Demand classification. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_004" name="OFF-004 Identify Impacted Markets">
      <bpmn:documentation>Phase 1. Specify affected countries and network organisations. Team: Requestor. Tool: Pega. Output: Market information. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_005" name="OFF-005 Identify Sponsor">
      <bpmn:documentation>Phase 1. Record business sponsor and accountable contact. Team: Requestor. Tool: Pega. Output: Sponsor details. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_006" name="OFF-006 Define Required Date">
      <bpmn:documentation>Phase 1. Record requested delivery date and business deadlines. Team: Requestor. Tool: Pega. Output: Required delivery date. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_007" name="OFF-007 Estimate Initial Effort">
      <bpmn:documentation>Phase 1. Provide preliminary effort or resource expectations. Team: Requestor. Tool: Pega. Output: Initial estimate. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_008" name="OFF-008 Identify Funding Position">
      <bpmn:documentation>Phase 1. Indicate whether funding or WBS codes already exist. Team: Requestor. Tool: Pega. Output: Funding information. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_009" name="OFF-009 Identify Dependencies">
      <bpmn:documentation>Phase 1. Record contractual, technical and system dependencies. Team: Requestor. Tool: Pega. Output: Dependency information. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_010" name="OFF-010 Attach Supporting Evidence">
      <bpmn:documentation>Phase 1. Attach business case, scope, quotations or supporting material. Team: Requestor. Tool: Pega. Output: Supporting documents. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_011" name="OFF-011 Submit Demand">
      <bpmn:documentation>Phase 1. Formally submit request. Team: Requestor. Tool: Pega. Output: Demand record. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_012" name="OFF-012 Generate Demand Reference">
      <bpmn:documentation>Phase 1. Register the request for subsequent tracking. Team: Demand Management. Tool: Pega. Output: Demand identifier. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_17" name="D1 · Demand complete?"/>
    <bpmn:task id="DM_01" name="DM-01 Raise Demand on Single Front Door">
      <bpmn:documentation>Phase 2. Requestor raises the demand on the Single Front Door. Team: Requestor. Tool: Single Front Door (Pega). Output: G0. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_02" name="DM-02 Triage the Demand">
      <bpmn:documentation>Phase 2. Network Demand Assurance Manager performs triage of the demand. Team: Demand Assurance Manager (DAM). Tool: Pega. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_18" name="Cross-functional?"/>
    <bpmn:task id="DM_03" name="DM-03 Other NW Function Handshake">
      <bpmn:documentation>Phase 2. Other NW function PS handshake with NW Demand Assurance Manager (if required). Team: NW Vertical Function SPOC. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_04" name="DM-04 Engage NW Vertical SPOC / Other NW Function">
      <bpmn:documentation>Phase 2. Engage NW vertical SPOC or other NW function PS. Team: NW Vertical Function SPOC. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_05" name="DM-05 Engage NW Vertical Teams for HL Impact">
      <bpmn:documentation>Phase 2. Engage NW vertical teams to start high-level impact assessment (G0 to G1). Team: Demand Assurance Manager (DAM). Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_06" name="DM-06 Other NW Functions Impact Assessment">
      <bpmn:documentation>Phase 2. Other NW function vertical teams perform impact assessment. Team: Other NW Functions. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_07" name="DM-07 IT Impact Assessment">
      <bpmn:documentation>Phase 2. IT teams perform impact assessment. Team: IT. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_08" name="DM-08 Solution Design Definition">
      <bpmn:documentation>Phase 2. Solution design definition. Team: NSE. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_19" name="Privacy relevant?"/>
    <bpmn:task id="DM_09" name="DM-09 Privacy Check">
      <bpmn:documentation>Phase 2. Privacy assessment where the demand is privacy-relevant. Team: Cyber Security &amp; Privacy. Tool: . Output: Privacy check. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_10" name="DM-10 Complete HL Design and Feasibility">
      <bpmn:documentation>Phase 2. Coordinate to complete high-level design and feasibility from all NW verticals. Team: Demand Governance Team. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_11" name="DM-11 Reporting and SLA Management">
      <bpmn:documentation>Phase 2. Reporting and SLA management. Team: Demand Governance Team. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_12" name="DM-12 Check Budget Availability and Priority">
      <bpmn:documentation>Phase 2. Check budget availability and priority from Market Sponsor. Team: Demand Governance Team. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_13" name="DM-13 Check NW Budget Availability">
      <bpmn:documentation>Phase 2. Check the NW budget availability. Team: NSE Planning. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_14" name="DM-14 Consolidate and Submit to Demand Board">
      <bpmn:documentation>Phase 2. Consolidation of impact assessment and submission to Demand Board. Team: Demand Governance Team. Tool: . Output: G2. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_013" name="OFF-013 Review Submitted Demand">
      <bpmn:documentation>Phase 3. Examine request completeness and supporting information. Team: Demand Management. Tool: Pega. Output: Review result. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_014" name="OFF-014 Validate Request Classification">
      <bpmn:documentation>Phase 3. Confirm internal/external demand route. Team: Demand Management. Tool: Pega. Output: Confirmed classification. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_015" name="OFF-015 Check Existing Demand">
      <bpmn:documentation>Phase 3. Identify related or previously submitted requests. Team: Demand Management. Tool: Pega / existing records. Output: Duplicate assessment. Status: T</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_016" name="OFF-016 Check Existing Programme">
      <bpmn:documentation>Phase 3. Determine whether the requirement belongs to an existing programme. Team: Planning / Demand Management. Tool: BPT / planning records. Output: Programme alignment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_017" name="OFF-017 Check Approved DB">
      <bpmn:documentation>Phase 3. Determine whether investment is already included in the financial plan. Team: Network Market Planning. Tool: BPT. Output: In-plan/off-plan assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_018" name="OFF-018 Identify Responsible Network Function">
      <bpmn:documentation>Phase 3. Determine impacted network verticals. Team: Demand Management. Tool: Pega. Output: Functional assignment. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_019" name="OFF-019 Assign Technical Assessment">
      <bpmn:documentation>Phase 3. Route demand to relevant technical stakeholders. Team: Demand Management. Tool: Pega. Output: Assessment ownership. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_020" name="OFF-020 Assess Initial Priority">
      <bpmn:documentation>Phase 3. Evaluate urgency and business significance. Team: Business Sponsor / Planning. Tool: Assessment criteria. Output: Priority. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_021" name="OFF-021 Confirm Qualification">
      <bpmn:documentation>Phase 3. Accept demand for detailed assessment or return/reject. Team: Demand Management. Tool: Pega. Output: Qualification decision. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_20" name="Qualified?"/>
    <bpmn:exclusiveGateway id="GW_21" name="D2 · Covered by approved investment?"/>
    <bpmn:task id="OFF_022" name="OFF-022 Review Technical Requirement">
      <bpmn:documentation>Phase 4. Examine functional and non-functional requirements. Team: Network Engineering. Tool: Pega / documents. Output: Requirement assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_023" name="OFF-023 Identify Network Domains">
      <bpmn:documentation>Phase 4. Identify transmission, IP, RAN, Core or other impacted domains. Team: Network Engineering. Tool: Network documentation. Output: Domain assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_024" name="OFF-024 Analyse Existing Capacity">
      <bpmn:documentation>Phase 4. Assess available infrastructure and capacity. Team: Network Planning / Engineering. Tool: Network analytics. Output: Capacity assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_025" name="OFF-025 Identify Technical Options">
      <bpmn:documentation>Phase 4. Develop feasible solution alternatives. Team: Solution Architecture. Tool: Design tools. Output: Solution options. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_026" name="OFF-026 Assess Dependencies">
      <bpmn:documentation>Phase 4. Identify systems, infrastructure and delivery dependencies. Team: Engineering. Tool: Design documentation. Output: Dependency register. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_027" name="OFF-027 Assess Security Impact">
      <bpmn:documentation>Phase 4. Determine whether security assessment is required. Team: Security / Engineering. Tool: Security process. Output: Security requirements. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_028" name="OFF-028 Assess Supplier Dependencies">
      <bpmn:documentation>Phase 4. Identify vendor equipment or services. Team: Engineering / Supply Chain. Tool: Supplier information. Output: Supplier requirements. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_029" name="OFF-029 Estimate Delivery Effort">
      <bpmn:documentation>Phase 4. Estimate engineering activities and implementation complexity. Team: Engineering / Delivery. Tool: Estimation templates. Output: Effort estimate. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_030" name="OFF-030 Estimate Technical Costs">
      <bpmn:documentation>Phase 4. Calculate equipment and implementation costs. Team: Engineering / Finance. Tool: Excel / costing tools. Output: Cost estimate. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_031" name="OFF-031 Identify Delivery Risks">
      <bpmn:documentation>Phase 4. Evaluate technical and implementation risks. Team: Engineering / Delivery. Tool: Risk register. Output: Risk assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_032" name="OFF-032 Confirm Preferred Solution">
      <bpmn:documentation>Phase 4. Select technically appropriate option. Team: Engineering / Solution Architecture. Tool: Design approval process. Output: Preferred solution. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_033" name="OFF-033 Complete Technical Assessment">
      <bpmn:documentation>Phase 4. Confirm feasibility and outstanding conditions. Team: Engineering. Tool: Pega / documents. Output: Technical assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_22" name="D3 · Technically feasible?"/>
    <bpmn:task id="OFF_034" name="OFF-034 Identify Resource Roles">
      <bpmn:documentation>Phase 5. Define required engineering and delivery roles. Team: Engineering / Delivery. Tool: Pega / estimates. Output: Role requirements. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_035" name="OFF-035 Estimate Resource Effort">
      <bpmn:documentation>Phase 5. Estimate person-days or FTE requirements. Team: Engineering / Delivery. Tool: Estimation tools. Output: Resource estimate. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_036" name="OFF-036 Create Resource Demand">
      <bpmn:documentation>Phase 5. Register workforce requirements. Team: Resource Management. Tool: WFM / local process. Output: Resource request. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_037" name="OFF-037 Check Workforce Capacity">
      <bpmn:documentation>Phase 5. Identify available resources. Team: Resource Management. Tool: WFM. Output: Capacity position. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_038" name="OFF-038 Identify Skills Gaps">
      <bpmn:documentation>Phase 5. Compare required skills with available workforce. Team: Resource Management. Tool: WFM. Output: Skills gap. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_039" name="OFF-039 Assess Competing Commitments">
      <bpmn:documentation>Phase 5. Identify conflicts with existing projects. Team: Resource Management. Tool: WFM. Output: Resource conflicts. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_040" name="OFF-040 Determine Booking Requirement">
      <bpmn:documentation>Phase 5. Establish whether soft booking is necessary. Team: Resource Management. Tool: WFM / local process. Output: Booking decision. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_23" name="Soft booking needed?"/>
    <bpmn:task id="OFF_041" name="OFF-041 Perform Soft Booking">
      <bpmn:documentation>Phase 5. Tentatively reserve resources where required. Team: Resource Management. Tool: WFM. Output: Provisional allocation. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_042" name="OFF-042 Identify External Resource Needs">
      <bpmn:documentation>Phase 5. Determine whether contractors or suppliers are required. Team: Delivery / Resource Management. Tool: Workforce / procurement tools. Output: External resource needs. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_043" name="OFF-043 Confirm Resource Feasibility">
      <bpmn:documentation>Phase 5. Validate likely resource availability. Team: Resource Management / Delivery. Tool: WFM. Output: Resource assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_24" name="D4 · Can it be resourced?"/>
    <bpmn:task id="OFF_044" name="OFF-044 Prepare CAPEX Estimate">
      <bpmn:documentation>Phase 6. Calculate capital investment. Team: Engineering / Finance. Tool: Costing models. Output: CAPEX estimate. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_045" name="OFF-045 Prepare OPEX Estimate">
      <bpmn:documentation>Phase 6. Calculate recurring and non-capital costs. Team: Engineering / Finance. Tool: Costing models. Output: OPEX estimate. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_046" name="OFF-046 Estimate Business Benefits">
      <bpmn:documentation>Phase 6. Identify expected financial and operational benefits. Team: Business Sponsor. Tool: Business case. Output: Benefits estimate. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_047" name="OFF-047 Validate Cost Assumptions">
      <bpmn:documentation>Phase 6. Review quantities, unit costs and assumptions. Team: Finance / Planning. Tool: Excel / BPT. Output: Validated costs. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_048" name="OFF-048 Check Approved Budget">
      <bpmn:documentation>Phase 6. Determine whether sufficient funding already exists. Team: Network Market Planning / Finance. Tool: BPT / SAP. Output: Funding position. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_049" name="OFF-049 Identify Funding Gap">
      <bpmn:documentation>Phase 6. Calculate funding shortfall. Team: Finance. Tool: Financial model. Output: Funding gap. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_050" name="OFF-050 Assess Funding Alternatives">
      <bpmn:documentation>Phase 6. Consider budget transfers, reprioritisation or new funding. Team: Finance / Planning. Tool: BPT / financial models. Output: Funding options. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_051" name="OFF-051 Assess Financial Risks">
      <bpmn:documentation>Phase 6. Review cost uncertainty and financial dependencies. Team: Finance. Tool: Business case. Output: Financial risks. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_052" name="OFF-052 Prepare Financial Assessment">
      <bpmn:documentation>Phase 6. Consolidate costs, benefits and funding requirements. Team: Finance / Sponsor. Tool: Excel / templates. Output: Financial assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_053" name="OFF-053 Confirm Funding Route">
      <bpmn:documentation>Phase 6. Determine required planning and governance pathway. Team: Finance / Governance. Tool: Approval rules. Output: Funding route. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_25" name="D5 · Approved funding available?"/>
    <bpmn:task id="OFF_054" name="OFF-054 Prepare Business Case">
      <bpmn:documentation>Phase 7. Consolidate investment justification. Team: Business Sponsor / Planning. Tool: Business case template. Output: Draft business case. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_055" name="OFF-055 Document Technical Solution">
      <bpmn:documentation>Phase 7. Attach preferred technical solution. Team: Engineering. Tool: Design documents. Output: Technical evidence. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_056" name="OFF-056 Document Financial Requirements">
      <bpmn:documentation>Phase 7. Record CAPEX, OPEX and funding. Team: Finance. Tool: Financial template. Output: Financial evidence. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_057" name="OFF-057 Document Benefits">
      <bpmn:documentation>Phase 7. Describe expected outcomes and measurement. Team: Business Sponsor. Tool: Benefits template. Output: Benefits baseline. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_058" name="OFF-058 Document Risks">
      <bpmn:documentation>Phase 7. Record delivery and financial risks. Team: Sponsor / Delivery. Tool: Risk register. Output: Risk assessment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_059" name="OFF-059 Confirm Network Alignment">
      <bpmn:documentation>Phase 7. Obtain required vertical alignment. Team: Network Verticals / Planning. Tool: Review process. Output: Alignment evidence. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_060" name="OFF-060 Validate Business Case">
      <bpmn:documentation>Phase 7. Check completeness and consistency. Team: Finance / Planning. Tool: Review process. Output: Validated package. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_061" name="OFF-061 Finalise Approval Submission">
      <bpmn:documentation>Phase 7. Prepare decision-ready documentation. Team: Sponsor / Governance. Tool: Approval workflow. Output: Approval package. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_062" name="OFF-062 Determine Approval Authority">
      <bpmn:documentation>Phase 8. Identify required decision-makers. Team: Finance / Governance. Tool: Approval matrix. Output: Approval route. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_063" name="OFF-063 Check Plan Alignment">
      <bpmn:documentation>Phase 8. Confirm whether the investment must first be incorporated into the financial plan. Team: Planning / Finance. Tool: BPT / governance records. Output: Plan alignment. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_064" name="OFF-064 Submit Funding Request">
      <bpmn:documentation>Phase 8. Submit validated request for approval. Team: Sponsor / Requestor. Tool: SAB / local process. Output: Approval request. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_065" name="OFF-065 Perform Quality Check">
      <bpmn:documentation>Phase 8. Validate completeness and financial justification. Team: Governance / Finance. Tool: Approval workflow. Output: Quality result. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_066" name="OFF-066 Review Financial Assurance">
      <bpmn:documentation>Phase 8. Confirm cost, benefit and funding assumptions. Team: Finance. Tool: Financial documents. Output: Assurance result. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_067" name="OFF-067 Confirm Vertical Alignment">
      <bpmn:documentation>Phase 8. Validate impacted network functions. Team: Network Verticals. Tool: Governance process. Output: Alignment. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_068" name="OFF-068 Prepare Decision Materials">
      <bpmn:documentation>Phase 8. Consolidate information for approvers. Team: SAB Governance. Tool: Approval documents. Output: Decision pack. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_069" name="OFF-069 Conduct Approval Review">
      <bpmn:documentation>Phase 8. Assess the investment. Team: Authorised Decision-Makers. Tool: SAB / local process. Output: Decision. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_070" name="OFF-070 Record Decision">
      <bpmn:documentation>Phase 8. Capture approval, rejection or conditions. Team: Governance. Tool: Approval record. Output: Recorded decision. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="OFF_071" name="OFF-071 Communicate Outcome">
      <bpmn:documentation>Phase 8. Notify requestor and stakeholders. Team: Governance / Finance. Tool: Email / workflow. Output: Decision notification. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_26" name="D6 · Expenditure authorised?"/>
    <bpmn:task id="OFF_072" name="OFF-072 Initiate Funding Fulfilment">
      <bpmn:documentation>Phase 8. Trigger approved funding arrangements. Team: Finance. Tool: SAP / financial process. Output: Funding instruction. Status: V</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_15" name="DM-15 Demand Board Approval">
      <bpmn:documentation>Phase 9. Demand Board reviews the consolidated impact assessment. Team: Demand Governance Team. Tool: . Output: Demand approval or rejection. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_27" name="Demand Board approved?"/>
    <bpmn:exclusiveGateway id="GW_28" name="Product scenario C?"/>
    <bpmn:task id="DM_16" name="DM-16 Global Product Approval">
      <bpmn:documentation>Phase 9. Global product approval for product scenario C. Team: Global Product Board. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_29" name="Global product approved?"/>
    <bpmn:task id="DM_17" name="DM-17 NCAR: Approve In-year Plan Changes">
      <bpmn:documentation>Phase 9. NCAR governs approval of changes to the in-year plan, including agreement on prioritisation. Team: Demand Governance Team / Other NW Functions. Tool: . Output: NCAR. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_18" name="DM-18 Manage In-year Prioritisation">
      <bpmn:documentation>Phase 9. Management of in-year prioritisation. Team: NSE Planning. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_19" name="DM-19 NPRB: Projects and Funding Mobilisation">
      <bpmn:documentation>Phase 9. NPRB manages projects and funding mobilisation for the in-year project. Team: Demand Governance Team / Other NW Functions. Tool: . Output: NPRB. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_20" name="DM-20 Update LRP if Needed">
      <bpmn:documentation>Phase 9. Planning team updates the LRP if needed. Team: NSE Planning. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DM_21" name="DM-21 Manage Transition to Delivery">
      <bpmn:documentation>Phase 9. Manage transition to integrated delivery. Team: NW Vertical Function SPOC. Tool: . Status: C</bpmn:documentation>
