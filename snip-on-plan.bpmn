    <bpmn:startEvent id="START" name="Strategic network planning cycle starts"/>
    <bpmn:task id="ON_001" name="ON-001 Collect Strategic Inputs">
      <bpmn:documentation>Phase 1. Gather market, technology and business priorities. Team: Network Strategy. Tool: Planning documentation</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_002" name="ON-002 Analyse Network Performance">
      <bpmn:documentation>Phase 1. Identify capacity, quality and resilience issues. Team: Network Engineering. Tool: Network KPI tools</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_003" name="ON-003 Forecast Network Demand">
      <bpmn:documentation>Phase 1. Estimate future traffic and capacity requirements. Team: Network Planning. Tool: Forecasting models</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_004" name="ON-004 Identify Technology Requirements">
      <bpmn:documentation>Phase 1. Assess new technologies and upgrades. Team: Network Strategy / Engineering. Tool: Technology roadmaps</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_005" name="ON-005 Identify Investment Needs">
      <bpmn:documentation>Phase 1. Convert network requirements into investment proposals. Team: Network Planning. Tool: NEP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_006" name="ON-006 Define Investment Scenarios">
      <bpmn:documentation>Phase 1. Develop alternative investment options. Team: Network Strategy. Tool: Planning models</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_007" name="ON-007 Estimate Initial Costs">
      <bpmn:documentation>Phase 1. Estimate investment requirements. Team: Engineering / Finance. Tool: Excel / costing models</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_008" name="ON-008 Evaluate Strategic Alignment">
      <bpmn:documentation>Phase 1. Assess fit with network strategy. Team: Network Leadership / Planning. Tool: NEP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_009" name="ON-009 Prioritise Investment Needs">
      <bpmn:documentation>Phase 1. Rank proposed investments. Team: Network Planning / Leadership. Tool: NEP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_010" name="ON-010 Prepare NEP Submission">
      <bpmn:documentation>Phase 1. Consolidate planning inputs. Team: Network Planning. Tool: NEP templates</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_011" name="ON-011 Review NEP">
      <bpmn:documentation>Phase 1. Challenge and refine proposals. Team: Network Leadership. Tool: NEP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_012" name="ON-012 Approve Planning Direction">
      <bpmn:documentation>Phase 1. Confirm planning priorities. Team: Authorised Planning Leadership. Tool: Governance process</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_1" name="Direction approved?"/>
    <bpmn:task id="NEP_01" name="NEP-01 Provide Strategic Pre-guidance for Network">
      <bpmn:documentation>Phase 2. Provide strategic pre-guidance for Network. Team: NW Architect. Tool: . Output: May/June. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_02" name="NEP-02 Collect Demand">
      <bpmn:documentation>Phase 2. Collect traffic, service, business priorities and financial guidelines from markets, business functions, VF NW functions, VF Digital and IT. Team: Demand &amp; Planning. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_03" name="NEP-03 Market Analysis and Scenario Definition">
      <bpmn:documentation>Phase 2. Market analysis and forecasting (coverage, capabilities, competitors); scenario definition based on VF strategy, local priorities and group guidance. Team: Demand &amp; Planning. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_04" name="NEP-04 High-Level Cost Evaluation">
      <bpmn:documentation>Phase 2. Evaluate unitary costs for access rollout, innovation and BAU projects to implement the plan. Team: Demand &amp; Planning / NW Finance / NW Function Budget SPOC. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_05" name="NEP-05 Review NEP against Business Priorities &amp; VF Strategy">
      <bpmn:documentation>Phase 2. Review NEP against business priorities and VF strategy. Team: Engagement Executives / NW Finance / NW Function Budget SPOC. Tool: . Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_06" name="NEP-06 Review and Agree on the NEP">
      <bpmn:documentation>Phase 2. Review and agree on the NEP (governance meeting). Team: NW Director &amp; NW Leadership Team / Demand &amp; Planning. Tool: . Output: Governance meeting. Status: C</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_2" name="NEP agreed at LT and CNO level?"/>
