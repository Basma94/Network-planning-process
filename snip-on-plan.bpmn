    <bpmn:startEvent id="START" name="Strategic network planning cycle starts"/>
    <bpmn:task id="NEP_01" name="NEP-01 Provide Strategic Pre-guidance for Network">
      <bpmn:documentation>Phase 1. Provide strategic pre-guidance for Network. Team: NW Architect. Tool: . Output: May/June. Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_02" name="NEP-02 Collect Demand">
      <bpmn:documentation>Phase 1. Collect traffic, service, business priorities and financial guidelines from markets, business functions, VF NW functions, VF Digital and IT. Team: Demand &amp; Planning. Tool: . Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_03" name="NEP-03 Market Analysis and Scenario Definition">
      <bpmn:documentation>Phase 1. Market analysis and forecasting (coverage, capabilities, competitors); scenario definition based on VF strategy, local priorities and group guidance. Team: Demand &amp; Planning. Tool: . Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_04" name="NEP-04 High-Level Cost Evaluation">
      <bpmn:documentation>Phase 1. Evaluate unitary costs for access rollout, innovation and BAU projects to implement the plan. Team: Demand &amp; Planning / NW Finance / NW Function Budget SPOC. Tool: . Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_05" name="NEP-05 Review NEP against Business Priorities &amp; VF Strategy">
      <bpmn:documentation>Phase 1. Review NEP against business priorities and VF strategy. Team: Engagement Executives / NW Finance / NW Function Budget SPOC. Tool: . Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_06" name="NEP-06 Review and Agree on the NEP">
      <bpmn:documentation>Phase 1. Review and agree on the NEP (governance meeting). Team: NW Director &amp; NW Leadership Team / Demand &amp; Planning. Tool: . Output: Governance meeting. Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_1" name="NEP agreed at LT and CNO level?"/>
    <bpmn:task id="NEP_07" name="NEP-07 NEP Presented with Local ExCo">
      <bpmn:documentation>Phase 1. Present the NEP to Local ExCo. Team: CNO / Market CEO. Tool: . Output: Beginning of October. Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_08" name="NEP-08 Identify Challenges and Actions">
      <bpmn:documentation>Phase 1. Identification of challenges and actions. Team: Market CEO. Tool: . Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_09" name="NEP-09 Inform NW Leadership and NW Director">
      <bpmn:documentation>Phase 1. Inform NW Leadership and NW Director. Team: NW Director &amp; NW Leadership Team. Tool: . Output: Governance meeting. Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_10" name="NEP-10 Approve NW Rollout Strategy and 3-Year Plan">
      <bpmn:documentation>Phase 1. Approve NW rollout strategy and high-level 3-year plan per market. Team: Market CEO. Tool: . Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="NEP_11" name="NEP-11 Provide Feedback to NW Architecture Team">
      <bpmn:documentation>Phase 1. Provide feedback on alignment on strategy to NW Architecture Team. Team: Demand &amp; Planning. Tool: . Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="DB_01" name="DB-01 Share DB/LRP Calendar">
      <bpmn:documentation>Phase 2. Share the calendar for DB/LRP with major milestones, including CEO review and submission deadlines. Team: NW Finance BPR &amp; Local Controller. Tool: . Output: M0 Process kick-off (mid October). Status: C. Confidence: confirmed (Booklet_NPDDT_v10.11, independent copy in the Demand Harmonisation SharePoint.)</bpmn:documentation>
