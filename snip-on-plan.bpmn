    <bpmn:startEvent id="START" name="Strategic network planning cycle starts"/>
    <bpmn:task id="ON_001" name="ON-001 Collect Strategic Inputs">
      <bpmn:documentation>Phase 1. Gather market, technology and business priorities. Team: Network Strategy. Tool: Planning documentation</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_002" name="ON-002 Analyse Network Performance">
      <bpmn:documentation>Phase 1. Identify capacity, quality and resilience issues. Team: Network Engineering. Tool: Network KPI tools</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_003" name="ON-003 Forecast Network Demand">
      <bpmn:documentation>Phase 1. Estimate future traffic and capacity requirements. Team: Network Planning. Tool: Forecasting models</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_004" name="ON-004 Identify Technology Requirements">
      <bpmn:documentation>Phase 1. Assess new technologies and upgrades. Team: Network Strategy / Engineering. Tool: Technology roadmaps</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_005" name="ON-005 Identify Investment Needs">
      <bpmn:documentation>Phase 1. Convert network requirements into investment proposals. Team: Network Planning. Tool: NEP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_006" name="ON-006 Define Investment Scenarios">
      <bpmn:documentation>Phase 1. Develop alternative investment options. Team: Network Strategy. Tool: Planning models</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_007" name="ON-007 Estimate Initial Costs">
      <bpmn:documentation>Phase 1. Estimate investment requirements. Team: Engineering / Finance. Tool: Excel / costing models</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_008" name="ON-008 Evaluate Strategic Alignment">
      <bpmn:documentation>Phase 1. Assess fit with network strategy. Team: Network Leadership / Planning. Tool: NEP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_009" name="ON-009 Prioritise Investment Needs">
      <bpmn:documentation>Phase 1. Rank proposed investments. Team: Network Planning / Leadership. Tool: NEP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_010" name="ON-010 Prepare NEP Submission">
      <bpmn:documentation>Phase 1. Consolidate planning inputs. Team: Network Planning. Tool: NEP templates</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_011" name="ON-011 Review NEP">
      <bpmn:documentation>Phase 1. Challenge and refine proposals. Team: Network Leadership. Tool: NEP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_012" name="ON-012 Approve Planning Direction">
      <bpmn:documentation>Phase 1. Confirm planning priorities. Team: Authorised Planning Leadership. Tool: Governance process</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_1" name="Direction approved?"/>
    <bpmn:task id="ON_013" name="ON-013 Receive Budget Guidelines">
      <bpmn:documentation>Phase 2. Review planning assumptions and constraints. Team: Network Market Planning. Tool: Budget guidance</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_014" name="ON-014 Translate NEP into DB">
      <bpmn:documentation>Phase 2. Convert strategic investments into detailed budget requirements. Team: Network Planning. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_015" name="ON-015 Define Investment Quantities">
      <bpmn:documentation>Phase 2. Identify equipment and implementation volumes. Team: Network Verticals. Tool: BPT / Excel</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_016" name="ON-016 Define Unit Costs">
      <bpmn:documentation>Phase 2. Apply approved cost assumptions. Team: Finance / Engineering. Tool: Cost models</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_017" name="ON-017 Calculate Investment Costs">
      <bpmn:documentation>Phase 2. Calculate quantities × unit costs. Team: Vertical Budget SPOCs. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_018" name="ON-018 Allocate Costs by Period">
      <bpmn:documentation>Phase 2. Distribute expenditure across planning periods. Team: Finance / Planning. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_019" name="ON-019 Assign Financial Attributes">
      <bpmn:documentation>Phase 2. Populate required budget dimensions. Team: Vertical Budget SPOCs. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_020" name="ON-020 Validate Budget Inputs">
      <bpmn:documentation>Phase 2. Check completeness and accuracy. Team: Planning / Finance. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_021" name="ON-021 Submit Budget">
      <bpmn:documentation>Phase 2. Submit detailed budget data. Team: Vertical Budget SPOCs. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_022" name="ON-022 Consolidate Market Budget">
      <bpmn:documentation>Phase 2. Aggregate submissions. Team: Network Market Planning. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_023" name="ON-023 Review CAPEX Constraints">
      <bpmn:documentation>Phase 2. Check affordability and budget limits. Team: Finance / Planning. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_024" name="ON-024 Challenge Investments">
      <bpmn:documentation>Phase 2. Review costs, priorities and assumptions. Team: Network Leadership / Finance. Tool: BPT / reviews</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_025" name="ON-025 Reprioritise Budget">
      <bpmn:documentation>Phase 2. Adjust investment allocations. Team: Planning / Verticals. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_026" name="ON-026 Finalise DB">
      <bpmn:documentation>Phase 2. Produce agreed budget submission. Team: Planning / Finance. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_027" name="ON-027 Obtain DB Approval">
      <bpmn:documentation>Phase 2. Complete financial governance. Team: Authorised Approvers. Tool: Governance process</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_2" name="DB approved?"/>
    <bpmn:task id="ON_028" name="ON-028 Establish DB Baseline">
      <bpmn:documentation>Phase 2. Record approved investment allocations. Team: Planning / Finance. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_029" name="ON-029 Identify Investment for Execution">
      <bpmn:documentation>Phase 3. Select approved DB investment. Team: Network Planning / Delivery. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_030" name="ON-030 Retrieve Approved Scope">
      <bpmn:documentation>Phase 3. Obtain investment scope and assumptions. Team: Planning. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_031" name="ON-031 Validate Budget">
      <bpmn:documentation>Phase 3. Confirm approved financial allocation. Team: Finance. Tool: BPT / SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_032" name="ON-032 Validate Delivery Timing">
      <bpmn:documentation>Phase 3. Confirm planned execution period. Team: Planning / Delivery. Tool: Planning records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_033" name="ON-033 Validate Technical Requirements">
      <bpmn:documentation>Phase 3. Confirm technical scope remains valid. Team: Engineering. Tool: Design documentation</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_034" name="ON-034 Validate Cost Assumptions">
      <bpmn:documentation>Phase 3. Review latest expected costs. Team: Finance / Engineering. Tool: Financial models</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_035" name="ON-035 Validate Dependencies">
      <bpmn:documentation>Phase 3. Identify outstanding dependencies. Team: Delivery / Engineering. Tool: Planning records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_036" name="ON-036 Identify Resource Requirements">
      <bpmn:documentation>Phase 3. Determine workforce requirements. Team: Delivery / Resource Management. Tool: WFM / local tools</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_037" name="ON-037 Determine Mobilisation Route">
      <bpmn:documentation>Phase 3. Identify required financial and delivery controls. Team: Finance / Planning. Tool: Governance rules</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_038" name="ON-038 Initiate Mobilisation">
      <bpmn:documentation>Phase 3. Submit request to mobilise approved investment. Team: Planning / Sponsor. Tool: Applicable workflow</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_039" name="ON-039 Retrieve Approval Evidence">
      <bpmn:documentation>Phase 4. Identify existing DB approval. Team: Planning / Finance. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_040" name="ON-040 Confirm Scope Alignment">
      <bpmn:documentation>Phase 4. Check mobilisation scope against approved plan. Team: Planning. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_041" name="ON-041 Confirm Budget Availability">
      <bpmn:documentation>Phase 4. Validate available funding. Team: Finance. Tool: BPT / SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_042" name="ON-042 Check Financial Variance">
      <bpmn:documentation>Phase 4. Compare expected cost with approved amount. Team: Finance. Tool: Financial models</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_043" name="ON-043 Determine Additional Approval Need">
      <bpmn:documentation>Phase 4. Assess whether further spend approval is required. Team: Finance / Governance. Tool: SAB rules</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_3" name="Does the DB give enough authority?"/>
    <bpmn:task id="ON_044" name="ON-044 Reuse Existing Approval">
      <bpmn:documentation>Phase 4. Reuse valid approval evidence where permitted. Team: Governance. Tool: Approval records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_045" name="ON-045 Prepare Additional Justification">
      <bpmn:documentation>Phase 4. Address material changes if required. Team: Sponsor / Planning. Tool: Business case</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_046" name="ON-046 Submit Conditional Approval">
      <bpmn:documentation>Phase 4. Route only when additional approval is required. Team: Sponsor / Finance. Tool: SAB / local process</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_047" name="ON-047 Record Approval Outcome">
      <bpmn:documentation>Phase 4. Capture final authority to proceed. Team: Governance. Tool: Approval records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_048" name="ON-048 Confirm Funding Instruction">
      <bpmn:documentation>Phase 4. Trigger applicable financial setup. Team: Finance. Tool: SAP / workflow</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_049" name="ON-049 Retrieve Resource Assumptions">
      <bpmn:documentation>Phase 5. Identify resources assumed during planning. Team: Planning / Delivery. Tool: Planning records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_050" name="ON-050 Validate Resource Requirements">
      <bpmn:documentation>Phase 5. Confirm actual delivery needs. Team: Engineering / Delivery. Tool: Resource estimates</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_051" name="ON-051 Check Capacity">
      <bpmn:documentation>Phase 5. Assess workforce availability. Team: Resource Management. Tool: WFM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_052" name="ON-052 Check Existing Reservations">
      <bpmn:documentation>Phase 5. Identify existing resource allocations. Team: Resource Management. Tool: WFM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_053" name="ON-053 Resolve Conflicts">
      <bpmn:documentation>Phase 5. Address capacity constraints. Team: Resource Management / Delivery. Tool: WFM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_054" name="ON-054 Determine Booking Route">
      <bpmn:documentation>Phase 5. Establish whether soft/hard booking is required. Team: Resource Management. Tool: WFM</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_4" name="Booking required?"/>
    <bpmn:task id="ON_055" name="ON-055 Confirm Resources">
      <bpmn:documentation>Phase 5. Complete applicable resource allocation. Team: Resource Management. Tool: WFM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_056" name="ON-056 Record Resource Readiness">
      <bpmn:documentation>Phase 5. Confirm resource prerequisites. Team: Delivery / Resource Management. Tool: Workflow</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_057" name="ON-057 Initiate Mobilisation Case">
      <bpmn:documentation>Phase 6. Register approved investment for mobilisation. Team: Planning / Delivery. Tool: Workflow</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_058" name="ON-058 Validate DB Reference">
      <bpmn:documentation>Phase 6. Confirm approved investment record. Team: Planning. Tool: BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_059" name="ON-059 Validate Financial Approval">
      <bpmn:documentation>Phase 6. Check applicable authority. Team: Finance. Tool: Approval records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_060" name="ON-060 Confirm Delivery Owner">
      <bpmn:documentation>Phase 6. Assign delivery responsibility. Team: Delivery Management. Tool: PPM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_061" name="ON-061 Identify WBS Requirements">
      <bpmn:documentation>Phase 6. Determine financial structures. Team: Finance / IP&amp;H. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_062" name="ON-062 Check Existing SAP Project">
      <bpmn:documentation>Phase 6. Identify existing project definition. Team: IP&amp;H. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_5" name="SAP project exists?"/>
    <bpmn:task id="ON_063" name="ON-063 Prepare MDG Data">
      <bpmn:documentation>Phase 6. Populate required project/WBS information. Team: Finance / IP&amp;H. Tool: Excel MDG template</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_064" name="ON-064 Submit MDG Request">
      <bpmn:documentation>Phase 6. Submit project/WBS creation. Team: Authorised Requestor. Tool: SAP MDG</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_065" name="ON-065 Approve MDG Request">
      <bpmn:documentation>Phase 6. Review and approve master data. Team: APA Approver. Tool: SAP MDG</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_6" name="MDG approved?"/>
    <bpmn:task id="ON_066" name="ON-066 Create WBS">
      <bpmn:documentation>Phase 6. Establish approved financial structures. Team: SAP MDG. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_067" name="ON-067 Validate WBS">
      <bpmn:documentation>Phase 6. Confirm correct codes and attributes. Team: Finance / IP&amp;H. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_068" name="ON-068 Prepare Budget Load">
      <bpmn:documentation>Phase 6. Match approved funding to WBS. Team: Finance. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_069" name="ON-069 Execute Budget Load">
      <bpmn:documentation>Phase 6. Allocate approved budget. Team: Finance. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_070" name="ON-070 Confirm Funding">
      <bpmn:documentation>Phase 6. Verify financial availability. Team: Finance. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_071" name="ON-071 Confirm Resource Allocation">
      <bpmn:documentation>Phase 6. Finalise required booking. Team: Resource Management. Tool: WFM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_072" name="ON-072 Confirm Mobilisation Completion">
      <bpmn:documentation>Phase 6. Record completion of required controls. Team: Mobilisation / Delivery Owner. Tool: Workflow</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_073" name="ON-073 Validate Approved Scope">
      <bpmn:documentation>Phase 7. Confirm scope remains aligned with DB. Team: Delivery / Planning. Tool: BPT / design records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_074" name="ON-074 Confirm Funding">
      <bpmn:documentation>Phase 7. Verify usable budget. Team: Finance. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_075" name="ON-075 Confirm WBS">
      <bpmn:documentation>Phase 7. Verify project financial structures. Team: Finance / IP&amp;H. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_076" name="ON-076 Confirm Resources">
      <bpmn:documentation>Phase 7. Validate resource allocation. Team: Resource Management. Tool: WFM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_077" name="ON-077 Confirm Supplier Requirements">
      <bpmn:documentation>Phase 7. Identify external dependencies. Team: Procurement / Delivery. Tool: Supplier records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_078" name="ON-078 Confirm Technical Readiness">
      <bpmn:documentation>Phase 7. Validate implementation prerequisites. Team: Engineering. Tool: Design records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_079" name="ON-079 Resolve Exceptions">
      <bpmn:documentation>Phase 7. Address outstanding issues. Team: Delivery / Planning. Tool: Workflow</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_080" name="ON-080 Confirm Ready to Deliver">
      <bpmn:documentation>Phase 7. Record readiness decision. Team: Delivery Owner. Tool: Workflow</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_7" name="Ready to deliver?"/>
    <bpmn:task id="ON_081" name="ON-081 Prepare Delivery Plan">
      <bpmn:documentation>Phase 8. Confirm milestones and dependencies. Team: Delivery Manager. Tool: PPM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_082" name="ON-082 Confirm SoW">
      <bpmn:documentation>Phase 8. Validate supplier deliverables. Team: Delivery / Procurement. Tool: SoW</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_083" name="ON-083 Raise Shopping Cart">
      <bpmn:documentation>Phase 8. Initiate purchasing. Team: Requestor. Tool: EVO</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_084" name="ON-084 Obtain Procurement Approval">
      <bpmn:documentation>Phase 8. Complete applicable approvals. Team: Procurement / Finance. Tool: EVO</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_085" name="ON-085 Generate PO">
      <bpmn:documentation>Phase 8. Create purchase order. Team: Procurement. Tool: SAP / EVO</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_086" name="ON-086 Issue PO">
      <bpmn:documentation>Phase 8. Communicate purchase order. Team: Procurement. Tool: SAP / EVO</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_087" name="ON-087 Execute Work">
      <bpmn:documentation>Phase 8. Deliver network investment. Team: Engineering / Supplier. Tool: Delivery tools</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_088" name="ON-088 Track Progress">
      <bpmn:documentation>Phase 8. Monitor implementation. Team: Delivery Manager. Tool: PPM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_089" name="ON-089 Manage Changes">
      <bpmn:documentation>Phase 8. Assess scope, cost and schedule changes. Team: Delivery / Finance. Tool: Change process</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_090" name="ON-090 Confirm Delivery Acceptance">
      <bpmn:documentation>Phase 8. Validate delivered work. Team: Engineering / Service Owner. Tool: Acceptance records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_091" name="ON-091 Update Delivery Status">
      <bpmn:documentation>Phase 8. Record completion. Team: Delivery Manager. Tool: PPM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_092" name="ON-092 Receive Invoice">
      <bpmn:documentation>Phase 9. Receive supplier invoice. Team: Service Manager / Finance. Tool: Invoice process</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_093" name="ON-093 Validate Invoice">
      <bpmn:documentation>Phase 9. Check against PO and delivery. Team: Service Manager. Tool: EVO</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_094" name="ON-094 Record GRN">
      <bpmn:documentation>Phase 9. Confirm received goods/services. Team: Authorised Receiver. Tool: EVO</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_095" name="ON-095 Attach Evidence">
      <bpmn:documentation>Phase 9. Attach supporting documentation. Team: Service Manager. Tool: EVO</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_096" name="ON-096 Process Invoice">
      <bpmn:documentation>Phase 9. Complete invoice validation. Team: Accounts Payable. Tool: SAP / EVO</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_097" name="ON-097 Process Payment">
      <bpmn:documentation>Phase 9. Execute applicable payment. Team: Finance. Tool: SAP / EVO</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_098" name="ON-098 Capture Actuals">
      <bpmn:documentation>Phase 9. Record expenditure. Team: Finance. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_099" name="ON-099 Reconcile Commitments">
      <bpmn:documentation>Phase 9. Review open financial obligations. Team: Finance. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_100" name="ON-100 Analyse Variance">
      <bpmn:documentation>Phase 9. Compare budget, commitments and actuals. Team: Finance / Planning. Tool: SAP / reporting</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_101" name="ON-101 Update Forecast">
      <bpmn:documentation>Phase 9. Reflect latest financial position. Team: Finance / Planning. Tool: Forecasting tools</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_102" name="ON-102 Confirm Technical Completion">
      <bpmn:documentation>Phase 10. Validate completed investment. Team: Engineering. Tool: Acceptance records</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_103" name="ON-103 Complete Operational Handover">
      <bpmn:documentation>Phase 10. Transfer responsibility to operations. Team: Delivery / Operations. Tool: Handover documentation</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_104" name="ON-104 Complete Financial Reconciliation">
      <bpmn:documentation>Phase 10. Validate final expenditure. Team: Finance. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_105" name="ON-105 Review Open Commitments">
      <bpmn:documentation>Phase 10. Resolve outstanding POs and invoices. Team: Finance. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_106" name="ON-106 Close Financial Structures">
      <bpmn:documentation>Phase 10. Complete applicable project/WBS closure. Team: Finance / SAP Support. Tool: SAP</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_107" name="ON-107 Close Delivery Record">
      <bpmn:documentation>Phase 10. Record project completion. Team: Delivery Manager. Tool: PPM</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_108" name="ON-108 Review Planned Benefits">
      <bpmn:documentation>Phase 10. Retrieve original investment outcomes. Team: Planning / Sponsor. Tool: Business case / BPT</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_109" name="ON-109 Measure Realised Benefits">
      <bpmn:documentation>Phase 10. Compare actual outcomes against targets. Team: Planning / Business Owner. Tool: KPI reporting</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ON_110" name="ON-110 Capture Lessons Learned">
      <bpmn:documentation>Phase 10. Record improvement opportunities. Team: Delivery / Planning. Tool: Knowledge repository</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="END" name="Investment delivered, closed, benefits measured"/>
