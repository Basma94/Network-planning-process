    <bpmn:task id="PC_08" name="PC-08 Enhanced Reports Alignment">
      <bpmn:documentation>Phase 13. Enhanced reports alignment (only SDD, DCE and FAE). Team: Vertical SPOCs. Tool: . Output: Exceptional task. Status: I. Evidence: I</bpmn:documentation>
