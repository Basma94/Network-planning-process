    </bpmn:task>
    <bpmn:task id="CL_07" name="CL-07 Consolidate and Publish Snapshot">
      <bpmn:documentation>Phase 14. Consolidate the report and publish the snapshot to verticals and BP&amp;A. Team: NMP. Tool: . Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
