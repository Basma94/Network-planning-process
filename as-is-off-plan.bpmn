    </bpmn:task>
    <bpmn:task id="CL_01" name="CL-01 Provide List of WBS">
      <bpmn:documentation>Phase 14. Provide the list of WBS within the last 2 calendar days of the month to BP&amp;A (if the last day falls on Saturday, Sunday or Monday, share it by Friday). Team: NMP. Tool: . Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="CL_02" name="CL-02 Receive List of WBS">
      <bpmn:documentation>Phase 14. Receive the list of WBS. Team: BP&amp;A. Tool: . Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="CL_03" name="CL-03 Map SAP View to Verticals">
      <bpmn:documentation>Phase 14. Extract view from SAP and map to all verticals according to BPT forecast. Team: BP&amp;A. Tool: SAP / BPT. Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
