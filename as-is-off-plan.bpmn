    </bpmn:task>
    <bpmn:task id="RG_05" name="RG-05 Variance Commentary">
      <bpmn:documentation>Phase 12. Explain variances with mitigation actions. Team: Vertical SPOCs. Tool: . Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="RG_06" name="RG-06 Market Interlock">
      <bpmn:documentation>Phase 12. Run the monthly Market Interlock (child subprocess D3). Team: Demand Governance Team. Tool: Microsoft Teams. Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_36" name="Corrective action or replanning needed?"/>
    <bpmn:task id="PC_01" name="PC-01 Provide List of WBS by the 15th">
      <bpmn:documentation>Phase 13. Provide the list of WBS by the 15th calendar day of the month to BP&amp;A (if the 15th falls on Saturday, Sunday or Monday, share it by Friday). Team: NMP. Tool: . Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="PC_02" name="PC-02 Receive List of WBS">
      <bpmn:documentation>Phase 13. Receive the list of WBS. Team: BP&amp;A. Tool: . Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="PC_03" name="PC-03 Extract SAP Data for Pre-closure">
      <bpmn:documentation>Phase 13. Extract the SAP data for the pre-closure of month N. Team: NMP. Tool: SAP. Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="PC_04" name="PC-04 Map SAP View to Verticals">
      <bpmn:documentation>Phase 13. Extract view from SAP and map to all verticals according to BPT forecast. Team: BP&amp;A. Tool: SAP / BPT. Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
