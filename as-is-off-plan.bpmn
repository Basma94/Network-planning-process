    <bpmn:task id="MI_14" name="MI-14 Final Adjustments and Pre-read">
      <bpmn:documentation>Phase 15. Final adjustments and pre-read submission. Team: NSE Engagement Executives. Tool: . Status: I. Evidence: I</bpmn:documentation>
