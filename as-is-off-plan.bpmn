      <bpmn:documentation>Phase 14. Network consolidated financial view by market and vertical. Team: Vertical &amp; Planning Communities. Tool: . Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="MI_01" name="MI-01 Check Market Interlock Timetable">
      <bpmn:documentation>Phase 15. Check the Market Interlock timetable for all future meetings. Team: Demand Governance Team. Tool: . Output: Timetable accuracy check. Status: I. Evidence: I</bpmn:documentation>
    </bpmn:task>
