    <bpmn:task id="MI_15" name="MI-15 Communicate Signed-off Pack">
      <bpmn:documentation>Phase 15. Communicate the signed-off Market Interlock pack with stakeholders. Team: Demand Governance Team. Tool: Microsoft Teams. Status: I. Confidence: provisional (Detailed recurring flow from the booklet; kept outside the lifecycle and not certified until its governing procedure is evidenced.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="MI_16" name="MI-16 Governance Post Meeting">
      <bpmn:documentation>Phase 15. Governance post meeting and post Market Interlock activities (minutes, action tracking, additional requests). Team: Demand Governance Team. Tool: Microsoft Teams. Output: Governance meeting. Status: I. Confidence: provisional (Detailed recurring flow from the booklet; kept outside the lifecycle and not certified until its governing procedure is evidenced.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="FC_01" name="FC-01 Reconcile Actuals and Commitments">
      <bpmn:documentation>Phase 16. Reconcile actuals and commitments. Team: Finance. Tool: SAP. Status: I. Confidence: provisional (No mandatory financial-close checklist is implied; SAP and WBS closure rules are unverified.)</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="FC_02" name="FC-02 Resolve Remaining Procurement Items">
      <bpmn:documentation>Phase 16. Review outstanding POs and invoices. Team: Finance. Tool: SAP. Status: I. Confidence: provisional (No mandatory financial-close checklist is implied; SAP and WBS closure rules are unverified.)</bpmn:documentation>
    </bpmn:task>
